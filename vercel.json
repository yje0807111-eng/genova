{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "regions": ["icn1"],
  "github": {
    "enabled": true,
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-mux",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/lottery-expire",
      "schedule": "5 15 * * *"
    },
    {
      "path": "/api/cron/lottery-reminders",
      "schedule": "10 15 * * *"
    }
  ]
}
